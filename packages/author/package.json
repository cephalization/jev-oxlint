{
  "name": "@jev-oxlint/author",
  "version": "0.1.0",
  "description": "Authoring CLI for jev-oxlint linters: survey which guidance applies to a codebase, calibrate checks against an answer key, assemble the context for proposing new checks",
  "license": "Apache-2.0",
  "bin": {
    "jev-lint": "dist/cli.js"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod 755 dist/cli.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@jev-oxlint/engine": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@openai/codex-sdk": "^0.155.0",
    "@types/node": "^26.5.1"
  },
  "peerDependencies": {
    "@openai/codex-sdk": "^0.155.0",
    "oxlint": ">=1.79.0"
  },
  "peerDependenciesMeta": {
    "@openai/codex-sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
