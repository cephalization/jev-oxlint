{
  "name": "@jev-oxlint/engine",
  "version": "0.1.0",
  "description": "Runtime for jev-powered oxlint linters: redaction, sync bridge, cache, generic fact extraction, guidance routing, and the check contract",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "package.json"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "@types/node": "^26.5.1",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "oxlint": ">=1.79.0"
  },
  "engines": {
    "node": ">=22"
  }
}
